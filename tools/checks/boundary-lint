#!/bin/sh
# boundary-lint — no reference points in a direction the layer map forbids.
#
# docs/capabilities/boundary-lint.md is the card. ARCHITECTURE.md states the
# rules and owns why they exist; the machine-readable rule-id block inside its
# layer map section is what this script binds to, so that rewording a
# paragraph cannot silently retire a rule. A difference between the ids there
# and the ids implemented here is exit 2 in either direction: an id with no
# implementation is a rule nobody enforces, and an implementation with no id
# is a rule nobody wrote down.
#
# In a repository with no compiled code an edge is a path reference from one
# component's files into another's. A reference is a backticked span or a
# markdown link target containing a slash and none of space, tab, `*`, angle
# bracket, brace, or colon — the colon keeps a file:line locator and a
# compound allowlist key out of the set, neither of which is a path.
#
# Unlike tools/checks/doc-integrity, this check reads fenced and indented
# blocks like any other line: a path inside a payload transcript is still a
# path the reader of the copy follows, and the parent-directory allowance
# below is what keeps an illustrative filename legitimate.
#
# Exit 0 holds, exit 1 is a violation, exit 2 means undecidable.

cd "$(git rev-parse --show-toplevel)" || exit 2

LC_ALL=C
export LC_ALL

MAP=ARCHITECTURE.md
SECTION="## Layer map and dependency rules"
IMPLEMENTED="no-outward-payload-reference no-plan-file-dependency no-unprovided-skill-target"
DECISION="If the rule itself is wrong, change $MAP in this same commit and say why in the plan's Decision Log."

if [ ! -f "$MAP" ]; then
	echo "boundary-lint: cannot run — the layer map $MAP does not exist."
	echo "Restore it: the rules this check applies are stated there, and a check that finds no rules would pass over every file in the repository."
	exit 2
fi

# The rule-id block: indented lines in the layer map section whose first field
# is a hyphenated lowercase id followed by an em dash. Continuation lines are
# indented further and never take that shape.
ids=$(awk -v section="$SECTION" '
	$0 == section { inside = 1; next }
	/^## / { inside = 0 }
	inside != 1 { next }
	$0 !~ /^(    |\t)/ { next }
	$1 ~ /^[a-z][a-z0-9]*(-[a-z0-9]+)+$/ && $2 == "—" { print $1 }
' "$MAP" | sort)

if [ -z "$ids" ]; then
	echo "boundary-lint: cannot run — $MAP has no rule-id block under \"$SECTION\"."
	echo "Restore the block — one indented line per rule, its id then an em dash then the scope and the ban. This check binds to those ids, and a run over zero rules is a green output that means nothing."
	exit 2
fi

expected=$(printf '%s\n' $IMPLEMENTED | sort)
if [ "$ids" != "$expected" ]; then
	for id in $ids; do
		case " $IMPLEMENTED " in
		*" $id "*) ;;
		*) echo "boundary-lint: cannot run — $MAP names rule \`$id\`, which tools/checks/boundary-lint does not implement." ;;
		esac
	done
	for id in $IMPLEMENTED; do
		found=no
		for have in $ids; do
			[ "$have" = "$id" ] && found=yes
		done
		[ "$found" = yes ] || echo "boundary-lint: cannot run — tools/checks/boundary-lint implements rule \`$id\`, which $MAP does not name under \"$SECTION\"."
	done
	echo "Implement the rule in the check, or delete the id from the map — the two sets are one rule set, and drift in either direction leaves a rule unenforced or unwritten."
	exit 2
fi

rules=0
for id in $ids; do
	rules=$((rules + 1))
done

# The checked set is every markdown artifact outside plans/: the payload for
# the first rule, the procedures for the second, and all of it for the third,
# which is about files that are not plans naming files that are.
NAMED="AGENTS.md GOALS.md CLAUDE.md"

absent=0
for f in $NAMED $MAP; do
	if [ ! -f "$f" ]; then
		echo "boundary-lint: cannot run — $f is in the checked set and does not exist."
		absent=$((absent + 1))
	fi
done
for d in docs skills template; do
	if [ ! -d "$d" ]; then
		echo "boundary-lint: cannot run — $d/ is in the checked set and does not exist."
		absent=$((absent + 1))
	fi
done
if [ "$absent" -ne 0 ]; then
	echo "Restore the file, or update the checked set in tools/checks/boundary-lint to match the components this repository actually has."
	exit 2
fi

payload_files=$(find template -type f -name '*.md' | sort)
skill_files=$(find skills -type f -name '*.md' | sort)
files="$NAMED $MAP $(find docs skills template -type f -name '*.md' | sort)"

payload_count=0
for f in $payload_files; do
	payload_count=$((payload_count + 1))
done
skill_count=0
for f in $skill_files; do
	skill_count=$((skill_count + 1))
done
file_count=0
for f in $files; do
	file_count=$((file_count + 1))
done
if [ "$payload_count" -eq 0 ] || [ "$skill_count" -eq 0 ]; then
	echo "boundary-lint: cannot run — the payload half or the procedure set holds no markdown files."
	echo "Correct the paths in tools/checks/boundary-lint; a rule applied to an empty scope passes forever."
	exit 2
fi

extract='
	function consider(t) {
		if (t == "") { return }
		if (t !~ /\//) { return }
		if (t ~ /[ \t*<>{}:]/) { return }
		print FILENAME "\t" FNR "\t" t
	}
	{
		n = split($0, p, "`")
		for (i = 2; i <= n; i += 2) { consider(p[i]) }
		s = $0
		while (match(s, /\]\([^()]+\)/)) {
			consider(substr(s, RSTART + 2, RLENGTH - 3))
			s = substr(s, RSTART + RLENGTH)
		}
	}
'

refs=$(awk "$extract" $files)

# Banned mentions, the half of each rule that is about words rather than
# paths: the payload may not name its own source, and a procedure may not name
# the payload directory it is copied out of.
mentions=$(awk '
	{
		lc = tolower($0)
		if (index(lc, "blueprint")) { print FILENAME "\t" FNR "\tblueprint" }
		if (index($0, "skills/")) { print FILENAME "\t" FNR "\tskills/" }
	}
' $payload_files)
mentions="$mentions$(awk '
	{ if (index($0, "template/")) { print FILENAME "\t" FNR "\ttemplate/" } }
' $skill_files)"

# A payload reference resolves inside the payload when the path is there, or
# when its parent directory is: template/docs/capabilities/doc-integrity.md
# names a file its own failing case creates, which must not exist, and
# template/docs/ does.
payload_resolves() {
	[ -e "template/$1" ] && return 0
	parent=${1%/*}
	[ "$parent" = "$1" ] && return 1
	[ -d "template/$parent" ] && return 0
	return 1
}

# A procedure may name what the payload ships, or a procedure beside it. No
# parent-directory allowance here: the rule is precisely that a project's own
# card, spec, record or plan inside a payload directory is not namable.
skill_target_provided() {
	[ -e "template/$1" ] && return 0
	case "$1" in
	skills/*) [ -e "$1" ] && return 0 ;;
	esac
	return 1
}

total=0
violations=0
# Lines already reported for their path reference. The mention scan looks at
# the same lines, and a body naming the payload directory in a backticked path
# breaks one rule once — two blocks for one line would ask the reader to fix
# the same word twice.
reported=""
oldifs=$IFS
IFS='
'
for rec in $refs; do
	file=${rec%%	*}
	rest=${rec#*	}
	lineno=${rest%%	*}
	ref=${rest#*	}
	total=$((total + 1))
	case "$file" in
	template/*)
		if ! payload_resolves "$ref"; then
			violations=$((violations + 1))
			reported="$reported$file:$lineno
"
			echo "boundary-lint: $file:$lineno names \`$ref\`, which does not resolve inside the payload."
			echo "  $MAP no-outward-payload-reference: nothing under template/ may name a path outside template/, because a target project receives that directory with no ancestor context and the reference dangles on arrival."
			echo "  Point it at an artifact the payload ships, or write it unbackticked if it is an illustration rather than a path. $DECISION"
		fi
		;;
	skills/*)
		if ! skill_target_provided "$ref"; then
			violations=$((violations + 1))
			reported="$reported$file:$lineno
"
			echo "boundary-lint: $file:$lineno names \`$ref\`, which the payload does not ship."
			echo "  $MAP no-unprovided-skill-target: a procedure may name only what a bootstrapped project has — a path that resolves inside template/, or a sibling procedure under skills/."
			echo "  Name the directory instead of a file the project wrote itself, or add the artifact to the payload. $DECISION"
		fi
		;;
	esac
	case "$ref" in
	plans/active/* | plans/completed/*)
		if [ -f "$ref" ]; then
			violations=$((violations + 1))
			echo "boundary-lint: $file:$lineno references \`$ref\`, a plan file that exists."
			echo "  $MAP no-plan-file-dependency: plans reference artifacts and artifacts never reference plans, because a plan is the record of one change and an artifact that outlives it must not depend on it."
			echo "  State the fact in the artifact that owns it, or reach the plan through the card's history. $DECISION"
		fi
		;;
	esac
done

for rec in $mentions; do
	[ -n "$rec" ] || continue
	file=${rec%%	*}
	rest=${rec#*	}
	lineno=${rest%%	*}
	word=${rest#*	}
	case "$reported" in
	*"$file:$lineno
"*)
		continue
		;;
	esac
	violations=$((violations + 1))
	case "$file" in
	template/*)
		echo "boundary-lint: $file:$lineno mentions $word."
		echo "  $MAP no-outward-payload-reference: nothing under template/ may mention this repository, the blueprint, or the procedure directory, because a skeleton that names where it came from ships knowledge the copy cannot use."
		echo "  Say what the target project has instead. $DECISION"
		;;
	*)
		echo "boundary-lint: $file:$lineno mentions $word."
		echo "  $MAP no-unprovided-skill-target: a skill body may not name the payload directory, because a bootstrapped project does not receive it. Resolve it at run time through the AGENTS.md map of the checkout the procedure was invoked from."
		echo "  Name the artifact the project has, not the skeleton it came from. $DECISION"
		;;
	esac
done
IFS=$oldifs

if [ "$total" -eq 0 ]; then
	echo "boundary-lint: cannot run — no references were extracted from $file_count files."
	echo "Correct the extraction in tools/checks/boundary-lint; a rule with nothing to decide passes forever."
	exit 2
fi

if [ "$violations" -eq 0 ]; then
	echo "boundary-lint: ok — $total references examined in $file_count files, $rules rules applied from $MAP, no banned mention in $payload_count payload files or $skill_count procedures."
	exit 0
fi

noun="violations"
[ "$violations" -eq 1 ] && noun="violation"
echo "boundary-lint: $violations $noun in $file_count files, $total references examined."
exit 1
